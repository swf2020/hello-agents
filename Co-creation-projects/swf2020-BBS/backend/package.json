    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
